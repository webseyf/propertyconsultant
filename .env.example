# Lead Property Valuation & Asset Management Consultancy PLC
# Environment Variables Configuration Guide

# Next.js Application Port / Host
PORT=3000

# Primary Notification Recipient Email
NOTIFICATION_EMAIL=leadvaluation3@gmail.com

# Optional SMTP Configuration for Live Email Transmission
# (If omitted, all submitted enquiries are automatically persisted to /data/enquiries.json with full timestamp and IP tracking)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=leadvaluation3@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Lead Consultancy Web Inquiries <leadvaluation3@gmail.com>"
